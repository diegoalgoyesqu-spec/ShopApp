<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopApp.Views.HelpSupportDetailPage"
             xmlns:views="clr-namespace:ShopApp.Views"
             Title="HelpSupportDetailPage">

    <ContentPage.BindingContext>
        <views:HelpSupportDetailData />
    </ContentPage.BindingContext>

    <Grid Padding="10"
          RowDefinitions="Auto,*,Auto"
          ColumnDefinitions="2*,3*"
          ColumnSpacing="10"
          RowSpacing="10">

        <!-- Selector de productos -->
        <Picker Grid.Row="0"
                Grid.Column="0"
                Title="Selecciona un producto"
                ItemsSource="{Binding Products}"
                ItemDisplayBinding="{Binding Nombre}"
                SelectedItem="{Binding productoseleccionado, Mode=TwoWay}"
                HorizontalOptions="Fill" />

        <!-- Detalle del producto -->
        <VerticalStackLayout Grid.Row="0"
                             Grid.Column="1"
                             Spacing="6">

            <Label Text="Nombre" />
            <Label Text="{Binding productoseleccionado.Nombre}" />

            <Label Text="Descripcion" />
            <Label Text="{Binding productoseleccionado.Description}" />

            <Label Text="Precio" />
            <Label Text="{Binding productoseleccionado.Precio, StringFormat='{}{0:C}'}" />

        </VerticalStackLayout>

        <!-- Lista de productos -->
        <CollectionView Grid.Row="1"
                        Grid.Column="0"
                        ItemsSource="{Binding Products}"
                        SelectedItem="{Binding productoseleccionado, Mode=TwoWay}"
                        ItemTemplate="{StaticResource ProductDataTemplate}"
                        SelectionMode="Single"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill">

        </CollectionView>

        <!-- Cantidad -->
        <VerticalStackLayout Grid.Row="1"
                             Grid.Column="1"
                             Spacing="10"
                             VerticalOptions="Start">

            <Label Text="Cantidad"
                   FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="5"
                                   VerticalOptions="Center">

                <Stepper Minimum="1"
                         Maximum="100"
                         Increment="1"
                         x:Name="cantidad"
                         Value="{Binding cantidad, Mode=TwoWay}" />

                <Label VerticalOptions="Center"
                       Margin="4"
                       Text="{Binding Value, Source={x:Reference cantidad}}" />

            </HorizontalStackLayout>

        </VerticalStackLayout>

        <!-- Botón Agregar -->
        <Button Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Text="Agregar"
                Command="{Binding AddCommand}"
                HeightRequest="45"
                HorizontalOptions="Fill" />

    </Grid>
</ContentPage>
