<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ShopApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ShopApp.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="ShopApp">

    <FlyoutItem Title="Configuración">
        <Tab Title="Resumen">
            <ShellContent
                Title="Home"
                ContentTemplate="{DataTemplate views:MainPage}"
                Route="MainPage" />
        </Tab>

        <Tab Title="Productos">
            <ShellContent
                Title="Products"
                ContentTemplate="{DataTemplate views:ProductsPage}"
                Route="ProductsPage"/>
        </Tab>

        <Tab Title="Clientes">
            <ShellContent
                Route="ClientsPage"
                ContentTemplate="{DataTemplate views:ClientsPage}" />
        </Tab>
    </FlyoutItem>

    <ShellContent
        Title="Acerca de mi Tienda"
        ContentTemplate="{DataTemplate views:AboutPage}"
        Route="AboutPage" />
    
    <ShellContent
        Title="Help Supoport"
        ContentTemplate="{DataTemplate views:HelpSupportPage}"
        Route="HelpSupportPage" />

    <MenuItem
        Text="Abrir Repo"
        Clicked="MenuItem_Clicked" />

</Shell>